generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  UPLOAD
  GENERATED
  DERIVATIVE
}

enum TaskStatus {
  DRAFT
  QUOTED
  QUEUED
  ANALYZING
  GENERATING
  SUCCEEDED
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  phone     String?   @unique
  status    String    @default("active")
  projects  Project[]
  assets    Asset[]
  tasks     GenerationTask[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    String    @default("active")
  assets    Asset[]
  tasks     GenerationTask[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
}

model Asset {
  id             String     @id @default(cuid())
  userId         String
  projectId      String?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type           AssetType
  storageKey     String     @unique
  mime           String
  width          Int
  height         Int
  hash           String?
  parentAssetId  String?
  parentAsset    Asset?     @relation("AssetDerivatives", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivatives    Asset[]    @relation("AssetDerivatives")
  status         String     @default("ready")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model GenerationTask {
  id            String           @id @default(cuid())
  userId        String
  projectId     String?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  mode          String
  taskType      String
  moduleType    String?
  status        TaskStatus       @default(DRAFT)
  prompt        String
  params        Json
  progressStage String?
  items         GenerationItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model GenerationItem {
  id            String         @id @default(cuid())
  taskId        String
  task          GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status        TaskStatus     @default(QUEUED)
  outputAssetId String?
  provider      String?
  model         String?
  seed          String?
  cost          Decimal?       @db.Decimal(12, 4)
  errorCode     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([taskId, status])
}

