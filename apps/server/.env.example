API_PORT=4000
DATABASE_URL=postgresql://istudio:istudio_dev@127.0.0.1:55432/istudio?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
AUTH_JWT_SECRET=change-me-in-development
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AI_PROVIDER_ENABLED=true
# AI Endpoint / API Key / Model 在 Web 设置中配置。
# 可选：多实例使用同一个 32 字节密钥（Base64 编码）。
# 留空时自动创建 STORAGE_ROOT/.ai/encryption.key，务必随数据库一起备份。
AI_CONFIG_ENCRYPTION_KEY=

# 以下仅为旧部署的首次自动迁移，新的部署不需要填写。
BANANA_ROUTER_BASE_URL=https://api.bananarouter.com
BANANA_ROUTER_API_KEY=
BANANA_ROUTER_TIMEOUT_SECONDS=300

# 旧 OpenAI Compatible Prompt 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
