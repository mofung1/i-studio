{
  "name": "istudio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
