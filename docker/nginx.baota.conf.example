# Install only after obtaining a certificate for this exact hostname.
server {
    listen 80;
    server_name istudio.mcode.fun;
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/istudio.mcode.fun;
        try_files $uri =404;
    }
    location / {
        return 308 https://istudio.mcode.fun$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name istudio.mcode.fun;
    ssl_certificate /www/server/panel/vhost/cert/istudio.mcode.fun/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/istudio.mcode.fun/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ISTUDIO_TLS:1m;
    ssl_session_timeout 10m;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:33000;
        proxy_http_version 1.1;
        proxy_set_header Host istudio.mcode.fun;
        proxy_set_header X-Forwarded-Host istudio.mcode.fun;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Replace client-supplied headers at the public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 650s;
        proxy_read_timeout 650s;
        proxy_buffering off;
    }

    access_log /www/wwwlogs/istudio.mcode.fun.log;
    error_log /www/wwwlogs/istudio.mcode.fun.error.log;
}
