# Replace studio.example.com with your hostname, then obtain its certificate before installing.
server {
    listen 80;
    server_name studio.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/studio.example.com;
        try_files $uri =404;
    }
    location / {
        return 308 https://studio.example.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name studio.example.com;
    ssl_certificate /www/server/panel/vhost/cert/studio.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/studio.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ISTUDIO_TLS:1m;
    ssl_session_timeout 10m;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:33000;
        proxy_http_version 1.1;
        proxy_set_header Host studio.example.com;
        proxy_set_header X-Forwarded-Host studio.example.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Replace client-supplied headers at the public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 650s;
        proxy_read_timeout 650s;
        proxy_buffering off;
    }

    access_log /www/wwwlogs/studio.example.com.log;
    error_log /www/wwwlogs/studio.example.com.error.log;
}
