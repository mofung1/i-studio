# Generate this file on the cloud server as docker/.env.production.
# APP_DOMAIN is a hostname only, without https://, a port or a path.
APP_DOMAIN=
# Use a new random hexadecimal password (64 characters) so the database URL needs no escaping.
POSTGRES_PASSWORD=
ADMIN_USERNAME=
# 6–128 characters; prefer a long random password. Hexadecimal avoids Compose interpolation issues.
ADMIN_PASSWORD=
# Keep preview during acceptance; change to production and rebuild web when ready for indexing.
SITE_ENV=preview
GENERATION_WORKERS=4
# Change only if this subnet overlaps an existing Docker or private network.
PROXY_SUBNET=172.29.240.0/24
