# Next.js browser-side API endpoint
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# Optional server-side API address (e.g. http://api:4000 inside Docker)
# API_INTERNAL_BASE_URL=http://127.0.0.1:4000

# Public website origin. Match your actual local port; never used as a production canonical.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# development / preview / production. Production indexing also requires a production build
# and a real HTTPS origin. Local/preview default to noindex + robots Disallow: /.
SITE_ENV=development
