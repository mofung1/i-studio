# Replace with your published Docker Hub image. Local builds use istudio:local.
ISTUDIO_IMAGE=mofugn1/istudio:latest
WEB_PORT=8080
BIND_ADDRESS=0.0.0.0
# Generate a fresh password for this installation.
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
# 12–128 characters. The image's setup command can generate both passwords.
ADMIN_PASSWORD=
# Applied once on a fresh public library; upgrades preserve edits and deletions.
INSTALL_INSPIRATION=true
GENERATION_WORKERS=2
SITE_ENV=preview
# Optional public HTTPS origin for SEO, for example https://studio.example.com.
NEXT_PUBLIC_SITE_URL=
