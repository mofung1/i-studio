API_PORT=4000
DATABASE_URL=postgresql://istudio:istudio_dev@127.0.0.1:55432/istudio?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379
# 留空时自动创建 STORAGE_ROOT/.auth/signing.key；显式配置时使用随机长字符串。
AUTH_JWT_SECRET=
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
STORAGE_ROOT=storage/uploads
GENERATION_WORKERS=4
# 异步供应商每张图片的等待上限；单次 HTTP 请求超时另在网页 AI 服务设置中配置。
GENERATION_POLL_TIMEOUT_SECONDS=600
# AI Endpoint / API Key / Model 在 /admin/settings 配置，前台模型与单价在 /admin/models 配置。
# 数据库是运营模式必选项，不会回退到内存余额。
# 反向代理部署时，仅信任明确配置的代理网段来读取 X-Forwarded-For；代理必须覆盖外部同名头。
AUTH_TRUSTED_PROXY_CIDRS=
# 可选：多实例使用同一个 32 字节密钥（Base64 编码）。
# 留空时自动创建 STORAGE_ROOT/.ai/encryption.key，务必随数据库一起备份。
AI_CONFIG_ENCRYPTION_KEY=

# 可选：独立后台管理员，在 /admin/login 登录。与前台 users 完全分开，允许同名。
# 两项都填后启动时自动创建，不创建前台账号或积分钱包。
# 密码需 12–128 位，请自行填写强密码；示例不提供通用默认密码。
# 修改后重建 API 容器以同步；旧登录状态会失效。
# 清空两项并重建 API 容器，仅解除环境管理，不会删除账号。
ADMIN_USERNAME=
ADMIN_PASSWORD=
